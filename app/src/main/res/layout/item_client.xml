<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:weightSum="10"
        android:gravity="center_vertical">

        <!-- Nom : Poids 3.0 (réduit pour faire de la place) -->
        <TextView
            android:id="@+id/txtNomClient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="Nom"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Solde : Poids 2.0 -->
        <TextView
            android:id="@+id/txtSoldeClient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="0 DH"
            android:textColor="@color/titleColor"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center" />

        <!-- Bouton Payer : Poids 2.4 -->
        <Button
            android:id="@+id/btnTransactions"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="2.4"
            android:text="Payer"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/buttonColor"
            android:textAllCaps="false"
            android:padding="0dp"
            app:cornerRadius="8dp" />

        <!-- Icône Modifier (Crayon) -->
        <ImageButton
            android:id="@+id/btnEditClient"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="0.8"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?android:attr/selectableItemBackground"
            app:tint="@color/buttonColor" />

        <!-- Icône Infos (i) -->
        <ImageButton
            android:id="@+id/btnDetails"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.1"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?android:attr/selectableItemBackground"
            app:tint="@color/titleColor" />

        <!-- Icône Supprimer (Poubelle) -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?android:attr/selectableItemBackground"
            app:tint="#D32F2F" />

    </LinearLayout>
</androidx.cardview.widget.CardView>