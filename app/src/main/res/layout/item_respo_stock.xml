<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="10"
        android:gravity="center_vertical"
        android:background="@color/white">

        <!-- 1. Colonne Nom et Rôle (Poids réduit à 4.1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomRespo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nom"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtRoleRespo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rôle"
                android:textColor="#666666"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 2. Bouton Ajouter Stock (Poids réduit à 3.3) -->
        <Button
            android:id="@+id/btnAddStock"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="3.3"
            android:text="+ Stock"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/buttonColor"
            android:textAllCaps="false"
            android:padding="0dp"
            app:cornerRadius="10dp" />

        <!-- 3. Icône Recherche (Poids 1.3) -->
        <ImageButton
            android:id="@+id/btnViewDetails"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:src="@android:drawable/ic_menu_search"
            android:background="?android:attr/selectableItemBackground"
            android:tint="@color/titleColor" />

        <!-- 4. Icône Supprimer (Poids 1.3) -->
        <ImageButton
            android:id="@+id/btnDeleteRespo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?android:attr/selectableItemBackground"
            android:tint="#D32F2F" />

    </LinearLayout>
</androidx.cardview.widget.CardView>